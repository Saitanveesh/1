# MON Linux endpoint collector configuration (conffile; preserved across upgrades).
# Non-secret identifiers only. The collector takes no credential or token.
MON_TENANT_ID=local-tenant
MON_SITE_ID=local-site
MON_SENSOR_ID=local-sensor
MON_SITE_URL=http://127.0.0.1:8090
MON_POLL_INTERVAL_SECONDS=30
