logging {
  level = "warn"
}

loki.source.file "mon_suricata" {
  targets = [
    {
      "__path__" = "/var/log/mon/eve.json",
      "job" = "mon_suricata",
      "site" = "site-a",
    },
  ]
  forward_to = [loki.write.mon.receiver]
}

loki.write "mon" {
  endpoint {
    url = "http://127.0.0.1:3100/loki/api/v1/push"
  }
}
