# PC1 sample. Never commit actual secrets. Use restrictive filesystem permissions.
MON_DB_PASSWORD=REPLACE_WITH_STRONG_SECRET
MON_DATABASE_URL=postgresql+psycopg://mon:REPLACE_WITH_URL_ENCODED_SECRET@postgres:5432/mon
MON_AUTH_ISSUER=https://approved-identity-provider.invalid
MON_AUTH_AUDIENCE=mon-soc
# Mount issuer's trusted public key as deploy/four-pc/auth/public.pem (read-only).

